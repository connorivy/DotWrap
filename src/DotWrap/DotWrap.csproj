<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <Description>DotWrap: Attribute and helpers for Python/C# interop</Description>
    <IsPackable>true</IsPackable>
    <Authors>connorivy</Authors>
    <Description>DotWrap: Python/C# interop toolkit (meta-package)</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DotWrap.Shared/DotWrap.Shared.csproj" />
    <ProjectReference Include="../DotWrap.Generator/DotWrap.Generator.csproj" PrivateAssets="all" />
    <ProjectReference Include="../DotWrap.MSBuild/DotWrap.MSBuild.csproj" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="$(DotWrapDir)Build\DotWrap.targets" Pack="true" PackagePath="build/" />
    <None Include="$(DotWrapDir)Build\DotWrap.props" Pack="true" PackagePath="build/" />
    <None
      Include="$(MSBuildProjectDirectory)\..\DotWrap.Generator\bin\$(Configuration)\netstandard2.0\DotWrap.Generator.dll"
      Pack="true"
      PackagePath="analyzers/dotnet/cs"
      Visible="false"
    />
    <None
      Include="$(MSBuildProjectDirectory)\..\DotWrap.Shared\bin\$(Configuration)\netstandard2.0\DotWrap.Shared.dll"
      Pack="true"
      PackagePath="analyzers/dotnet/cs"
      Visible="true"
    />
    <!-- <None
      Include="$(MSBuildProjectDirectory)\..\DotWrap.MSBuild\bin\$(Configuration)\net7.0\DotWrap.MSBuild.dll"
      Pack="true"
      PackagePath="lib/net7.0"
      Visible="true"
    />
    <None
      Include="$(MSBuildProjectDirectory)\..\DotWrap.MSBuild\bin\$(Configuration)\net7.0\DotWrap.MSBuild.runtimeconfig.json"
      Pack="true"
      PackagePath="lib/net7.0"
      Visible="true"
    />
    <None
      Include="$(MSBuildProjectDirectory)\..\DotWrap.Shared\bin\$(Configuration)\netstandard2.0\DotWrap.Shared.dll"
      Pack="true"
      PackagePath="lib/net7.0"
      Visible="true"
    />
    <None
      Include="$(MSBuildProjectDirectory)\..\DotWrap.Operations\bin\$(Configuration)\net7.0\DotWrap.Operations.dll"
      Pack="true"
      PackagePath="lib/net7.0"
      Visible="true"
    /> -->
    <None
      Include="$(MSBuildProjectDirectory)\..\DotWrap.MSBuild\bin\$(Configuration)\net8.0\DotWrap.MSBuild.dll"
      Pack="true"
      PackagePath="lib/net8.0"
      Visible="true"
    />
    <None
      Include="$(MSBuildProjectDirectory)\..\DotWrap.MSBuild\bin\$(Configuration)\net8.0\DotWrap.MSBuild.runtimeconfig.json"
      Pack="true"
      PackagePath="lib/net8.0"
      Visible="true"
    />
    <None
      Include="$(MSBuildProjectDirectory)\..\DotWrap.Shared\bin\$(Configuration)\netstandard2.0\DotWrap.Shared.dll"
      Pack="true"
      PackagePath="lib/net8.0"
      Visible="true"
    />
    <None
      Include="$(MSBuildProjectDirectory)\..\DotWrap.MSBuild\bin\$(Configuration)\net10.0\DotWrap.MSBuild.dll"
      Pack="true"
      PackagePath="lib/net10.0"
      Visible="true"
    />
    <None
      Include="$(MSBuildProjectDirectory)\..\DotWrap.MSBuild\bin\$(Configuration)\net10.0\DotWrap.MSBuild.runtimeconfig.json"
      Pack="true"
      PackagePath="lib/net10.0"
      Visible="true"
    />
    <None
      Include="$(MSBuildProjectDirectory)\..\DotWrap.Shared\bin\$(Configuration)\netstandard2.0\DotWrap.Shared.dll"
      Pack="true"
      PackagePath="lib/net10.0"
      Visible="true"
    />
  </ItemGroup>
</Project>
