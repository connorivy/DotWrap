<Project>
  <PropertyGroup>
    <DotWrapRoot Condition="'$(DotWrapRoot)' == ''">$(MSBuildThisFileDirectory)..</DotWrapRoot>
    <DotWrapToolsPath Condition="'$(DotWrapToolsPath)' == ''"
      >$(DotWrapRoot)$(DotWrapSlash)lib$(DotWrapSlash)$(TargetFramework)</DotWrapToolsPath
    >
    <DotWrapGenerateAfterBuild Condition="'$(DotWrapGenerateAfterBuild)' == ''"
      >false</DotWrapGenerateAfterBuild
    >
    <WrapperGenTarget Condition="'$(DotWrapGenerateAfterBuild)' == 'true'">Build</WrapperGenTarget>
    <WrapperGenTarget Condition="'$(DotWrapGenerateAfterBuild)' != 'true'"
      >Publish</WrapperGenTarget
    >
    <CopyLibTarget Condition="'$(DotWrapGenerateAfterBuild)' == 'true'">Publish</CopyLibTarget>
    <CopyLibTarget Condition="'$(DotWrapGenerateAfterBuild)' != 'true'"
      >RunWrapperGen</CopyLibTarget
    >
  </PropertyGroup>
  <Target Name="RunWrapperGen" AfterTargets="$(WrapperGenTarget)">
    <Exec Command="dotnet --roll-forward Major &quot;$(DotWrapToolsPath)$(DotWrapSlash)DotWrap.MSBuild.dll&quot; &quot;$(TargetPath)&quot; build" />
  </Target>
  <Target Name="CopyNativeLibs" AfterTargets="$(CopyLibTarget)">
    <Exec Command="dotnet --roll-forward Major &quot;$(DotWrapToolsPath)$(DotWrapSlash)DotWrap.MSBuild.dll&quot; &quot;$(TargetPath)&quot; publish" />
  </Target>
</Project>
