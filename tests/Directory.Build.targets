<Project>
    <Target Name="asdf" BeforeTargets="Build">
        <Exec Command="echo DEBUG PRINT: buildPath: $(MSBuildProjectBuildPath)" />
        <!-- <Exec Command="echo DEBUG PRINT: publishPath: $(MSBuildProjectPublishPath)" /> -->
        <Exec Command="echo DEBUG PRINT: isPublishing: $(_IsPublishing)" />
        <Exec Command="echo DEBUG PRINT: dotWrapToolsPath: $(DotWrapToolsPath)" />
    </Target>

    <PropertyGroup Condition="'$(ContinuousIntegrationEnv)' == 'false'">
        <MSBuildProjectBuildPath>$(MSBuildThisFileDirectory)..\src\DotWrap.MSBuild\bin\$(Configuration)\net10.0</MSBuildProjectBuildPath>
        <MSBuildProjectPublishPath>$(MSBuildThisFileDirectory)..\src\DotWrap.MSBuild\bin\Release\net10.0\$(RuntimeIdentifier)</MSBuildProjectPublishPath>

        <DotWrapToolsPath 
            Condition="'$(_IsPublishing)' != 'true'">$(MSBuildProjectBuildPath)</DotWrapToolsPath>
        <DotWrapToolsPath 
            Condition="'$(_IsPublishing)' == 'true'">$(MSBuildProjectPublishPath)</DotWrapToolsPath>
        <!-- <DotWrapToolsPath>$(MSBuildProjectBuildPath)</DotWrapToolsPath> -->
    </PropertyGroup>

</Project>